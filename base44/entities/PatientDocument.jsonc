{
  "name": "PatientDocument",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Lab Report",
        "Prescription",
        "Imaging",
        "imaging",
        "Referral Letter",
        "Insurance Card",
        "Consent Form",
        "Discharge Summary",
        "Other"
      ],
      "description": "Type of document"
    },
    "file_url": {
      "type": "string",
      "description": "URL to uploaded file"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name"
    },
    "file_type": {
      "type": "string",
      "description": "MIME type"
    },
    "ocr_extracted_text": {
      "type": "string",
      "description": "OCR extracted content"
    },
    "ocr_edited": {
      "type": "boolean",
      "default": false
    },
    "document_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uploaded_by": {
      "type": "string"
    },
    "modality": {
      "type": "string",
      "description": "Imaging modality: Renal Ultrasound, Biopsy Slide, DMSA Scan, CT, MRI, etc."
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relX": {
            "type": "number"
          },
          "relY": {
            "type": "number"
          },
          "color": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "annotated_by": {
            "type": "string"
          }
        }
      },
      "description": "Image annotations with coordinates and notes"
    },
    "ai_report": {
      "type": "string",
      "description": "AI analysis report for this image"
    }
  },
  "required": [
    "patient_id",
    "document_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "data.patient_id": {
            "$in": {
              "$concat": [
                "{{user.data.patients_managed}}"
              ]
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}