{
  "name": "TreatmentTemplate",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Brief description of this treatment template, its intended diagnosis, and clinical scenario (up to 1000 characters)"
    },
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "diagnosis": {
      "type": "string",
      "description": "Associated diagnosis"
    },
    "specialty": {
      "type": "string",
      "description": "Medical specialty",
      "default": "Pediatric Nephrology"
    },
    "age_range": {
      "type": "string",
      "description": "Applicable age range"
    },
    "plan_data": {
      "type": "object",
      "description": "Complete treatment plan structure",
      "additionalProperties": true
    },
    "usage_count": {
      "type": "number",
      "description": "Times this template was used",
      "default": 0
    },
    "is_public": {
      "type": "boolean",
      "description": "Shareable with other clinicians",
      "default": false
    }
  },
  "required": [
    "name",
    "diagnosis",
    "plan_data"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}