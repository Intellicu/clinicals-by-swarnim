{
  "name": "Specialty",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Specialty name (e.g., Pediatric Nephrology, Pediatric Neurology)"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide-react"
    },
    "color": {
      "type": "string",
      "description": "Primary color for the specialty"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the specialty"
    },
    "is_default": {
      "type": "boolean",
      "description": "Whether this is a default specialty",
      "default": false
    },
    "created_by_user": {
      "type": "string",
      "description": "Email of user who created this (blank for default)"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}