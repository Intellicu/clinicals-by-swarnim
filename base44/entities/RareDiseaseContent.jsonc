{
  "name": "RareDiseaseContent",
  "type": "object",
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "coe_hospital",
        "nprd_disease",
        "pathway",
        "genetic_panel",
        "registry",
        "monitoring_protocol"
      ],
      "description": "Type of content record"
    },
    "section_id": {
      "type": "string",
      "description": "Unique identifier for this content block (e.g. 'ahus', 'coe_aiims_patna')"
    },
    "title": {
      "type": "string",
      "description": "Display title"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "description": "Flexible content fields (varies by content_type)"
    },
    "further_reading": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "year": {
            "type": "string"
          }
        }
      },
      "description": "Further reading links for pathways"
    },
    "linked_guideline_id": {
      "type": "string",
      "description": "Optional pointer to the canonical Guideline record that holds the full detailed content for this topic. Used to render an 'Open full pathway' link instead of duplicating content."
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "Last auto-sync timestamp"
    },
    "sync_query": {
      "type": "string",
      "description": "Search query used for auto-sync"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "content_type",
    "section_id",
    "title"
  ]
}