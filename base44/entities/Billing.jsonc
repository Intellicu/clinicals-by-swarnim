{
  "name": "Billing",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "visit_date": {
      "type": "string",
      "format": "date"
    },
    "service_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Partial",
        "Paid"
      ],
      "default": "Pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Cash",
        "UPI",
        "Card",
        "Online",
        "Waived"
      ],
      "default": "Cash"
    },
    "notes": {
      "type": "string"
    },
    "receipt_generated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "patient_id",
    "total_amount",
    "visit_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}