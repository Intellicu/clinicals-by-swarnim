{
  "name": "Workspace",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Workspace name"
    },
    "description": {
      "type": "string",
      "description": "Workspace description"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of workspace owner"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "doctor",
              "nurse",
              "assistant",
              "view_only"
            ]
          }
        }
      },
      "description": "Workspace members with roles"
    },
    "settings": {
      "type": "object",
      "properties": {
        "default_view": {
          "type": "string",
          "enum": [
            "list",
            "calendar",
            "kanban"
          ]
        },
        "appointment_duration": {
          "type": "number"
        },
        "allow_online_booking": {
          "type": "boolean"
        }
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.members.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}