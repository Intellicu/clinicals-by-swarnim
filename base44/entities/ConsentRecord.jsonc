{
  "name": "ConsentRecord",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient entity"
    },
    "consent_type": {
      "type": "string",
      "enum": [
        "Clinical Procedure",
        "Research Participation",
        "Genetic Testing",
        "Imaging",
        "Biobank Storage",
        "Data Sharing",
        "Telemedicine",
        "Photography"
      ],
      "description": "Type of consent obtained"
    },
    "study_id": {
      "type": "string",
      "description": "ResearchProject ID if research consent"
    },
    "study_title": {
      "type": "string"
    },
    "iec_approval_number": {
      "type": "string",
      "description": "IEC/IRB approval number"
    },
    "consent_date": {
      "type": "string",
      "format": "date"
    },
    "consent_form_url": {
      "type": "string",
      "description": "Scanned/uploaded consent form"
    },
    "guardian_name": {
      "type": "string",
      "description": "Parent/guardian name (for paediatric patients)"
    },
    "guardian_relation": {
      "type": "string",
      "description": "Relation to patient (Mother/Father/Legal Guardian)"
    },
    "guardian_id_verified": {
      "type": "boolean",
      "default": false
    },
    "witness_name": {
      "type": "string"
    },
    "language_of_consent": {
      "type": "string",
      "enum": [
        "Hindi",
        "English",
        "Maithili",
        "Bhojpuri",
        "Other"
      ],
      "default": "Hindi"
    },
    "interpreter_used": {
      "type": "boolean",
      "default": false
    },
    "verbal_consent_recorded": {
      "type": "boolean",
      "default": false
    },
    "audio_url": {
      "type": "string",
      "description": "Audio recording of verbal consent if applicable"
    },
    "capacity_assessed": {
      "type": "boolean",
      "default": true,
      "description": "Was patient/guardian capacity assessed?"
    },
    "voluntariness_confirmed": {
      "type": "boolean",
      "default": true
    },
    "re_consent_required": {
      "type": "boolean",
      "default": false,
      "description": "Protocol amendment requiring re-consent"
    },
    "re_consent_date": {
      "type": "string",
      "format": "date"
    },
    "withdrawal_date": {
      "type": "string",
      "format": "date"
    },
    "withdrawal_reason": {
      "type": "string"
    },
    "data_retained_after_withdrawal": {
      "type": "boolean",
      "description": "Whether existing data retained per protocol"
    },
    "obtained_by": {
      "type": "string",
      "description": "Clinician/researcher email who obtained consent"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "consent_type",
    "consent_date",
    "obtained_by"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.obtained_by": "{{user.email}}"
        },
        {
          "data.patient_id": {
            "$in": {
              "$concat": [
                "{{user.data.patients_managed}}"
              ]
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.obtained_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.obtained_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}