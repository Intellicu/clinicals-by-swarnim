{
  "name": "ResearchProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner email for isolation"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active",
        "Analysis",
        "Writing",
        "Submitted",
        "Published",
        "Archived"
      ],
      "default": "Draft"
    },
    "study_type": {
      "type": "string",
      "description": "RCT, Cohort, Case-Control, etc."
    },
    "pico": {
      "type": "object",
      "properties": {
        "population": {
          "type": "string"
        },
        "intervention": {
          "type": "string"
        },
        "comparison": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "structured_question": {
          "type": "string"
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypothesis": {
      "type": "string"
    },
    "sample_size": {
      "type": "object",
      "properties": {
        "calculated": {
          "type": "number"
        },
        "method": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "justification": {
          "type": "string"
        }
      }
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "statistical_plan": {
      "type": "string"
    },
    "statistical_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ethics_status": {
      "type": "string",
      "enum": [
        "Not Started",
        "Pending",
        "Approved",
        "Waived"
      ],
      "default": "Not Started"
    },
    "iec_number": {
      "type": "string"
    },
    "current_step": {
      "type": "number",
      "default": 0
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "total_enrolled": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "institution": {
      "type": "string"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "owner_email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}