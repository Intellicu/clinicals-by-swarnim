{
  "name": "MonitoringTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "category": {
      "type": "string",
      "description": "Monitoring category"
    },
    "description": {
      "type": "string",
      "description": "Template description"
    },
    "frequency": {
      "type": "string",
      "description": "Recommended monitoring frequency"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      },
      "description": "Template fields"
    },
    "instructions": {
      "type": "string",
      "description": "How to use template"
    },
    "critical_values": {
      "type": "object",
      "additionalProperties": true,
      "description": "Alert thresholds"
    },
    "created_by": {
      "type": "string",
      "description": "User who created this template"
    }
  },
  "required": [
    "name",
    "category",
    "fields"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}