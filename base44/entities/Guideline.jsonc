{
  "name": "Guideline",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Guideline title"
    },
    "category": {
      "type": "string",
      "enum": [
        "AKI",
        "CKD",
        "Nephrotic Syndrome",
        "Hypertension",
        "Electrolytes",
        "Acid-Base",
        "RTA",
        "Stones",
        "Dialysis",
        "Transplant",
        "Glomerular Diseases",
        "Tubular Disorders",
        "Immunisation",
        "General Pediatrics",
        "Neonatology",
        "Infection",
        "General"
      ],
      "description": "Guideline category"
    },
    "source": {
      "type": "string",
      "description": "Guideline source (KDIGO, ISPN, IPNA, ISPD, AAP, etc.)"
    },
    "organization": {
      "type": "string",
      "description": "Full organization name"
    },
    "region": {
      "type": "string",
      "enum": [
        "Global",
        "India",
        "Europe",
        "North America",
        "Asia-Pacific"
      ],
      "default": "Global"
    },
    "year": {
      "type": "number",
      "description": "Year of publication"
    },
    "summary": {
      "type": "string"
    },
    "scope_and_population": {
      "type": "string"
    },
    "key_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "practice_pearls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_level": {
      "type": "string",
      "description": "Evidence level/grade"
    },
    "linked_module": {
      "type": "string",
      "description": "Primary linked clinical module"
    },
    "population": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clinical_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_drugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pdf_url": {
      "type": "string"
    },
    "external_link": {
      "type": "string"
    },
    "doi_url": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "multimedia": {
      "type": "object",
      "properties": {
        "audio_overview_url": {
          "type": "string"
        },
        "video_overview_url": {
          "type": "string"
        },
        "slides_url": {
          "type": "string"
        },
        "infographics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            }
          }
        },
        "podcast_episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "audio_url": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "transcript": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "table",
              "flowchart",
              "diagram",
              "algorithm",
              "figure"
            ]
          }
        }
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "key_points": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Structured academic citations"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "import_source": {
          "type": "string"
        },
        "import_url": {
          "type": "string"
        },
        "import_date": {
          "type": "string",
          "format": "date-time"
        },
        "rights_confirmation": {
          "type": "boolean"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Review",
        "Published",
        "Archived"
      ],
      "default": "Draft"
    },
    "version": {
      "type": "string"
    },
    "is_editable": {
      "type": "boolean",
      "default": false
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "version_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "EXPERT_REVIEWED",
        "PENDING_REVIEW",
        "AI_GENERATED",
        "AI_SUGGESTION",
        "DRAFT"
      ],
      "default": "DRAFT",
      "description": "Expert review governance status"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Expert reviewer name/email"
    },
    "last_expert_update": {
      "type": "string",
      "format": "date",
      "description": "Date of last expert review/edit"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Full audit trail of reviews, approvals, and edits"
    },
    "ai_pending_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "AI-generated sections awaiting expert approval"
    },
    "primary_guideline_org": {
      "type": "string",
      "description": "Primary operational guideline organisation (e.g. ISPN, AAP)"
    },
    "supporting_guidelines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supporting guideline sources"
    },
    "org_definition_notes": {
      "type": "object",
      "additionalProperties": true,
      "description": "Organisation-specific definition differences"
    }
  },
  "required": [
    "title",
    "category",
    "source",
    "scope_and_population"
  ]
}