{
  "name": "Guideline",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Guideline title"
    },
    "category": {
      "type": "string",
      "enum": [
        "AKI",
        "CKD",
        "Nephrotic Syndrome",
        "Hypertension",
        "Electrolytes",
        "Acid-Base",
        "RTA",
        "Stones",
        "Dialysis",
        "Transplant",
        "Glomerular Diseases",
        "Tubular Disorders",
        "Immunisation",
        "General Pediatrics",
        "Neonatology",
        "Infection",
        "General",
        "Endocrinology",
        "Neurology",
        "Respiratory",
        "Gastroenterology",
        "Cardiology",
        "Haematology",
        "Nutrition & Growth",
        "Developmental Pediatrics",
        "Adolescent Health",
        "Rheumatology",
        "Rare Disease"
      ],
      "description": "Guideline category"
    },
    "source": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "enum": [
        "Global",
        "India",
        "Europe",
        "North America",
        "Asia-Pacific"
      ],
      "default": "Global"
    },
    "year": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "scope_and_population": {
      "type": "string"
    },
    "key_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "practice_pearls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "algorithm": {
      "type": "object",
      "description": "Algorithmic decision pathway for clinical use",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "start",
                  "decision",
                  "action",
                  "outcome",
                  "emergency",
                  "end"
                ]
              },
              "text": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "enum": [
                  "green",
                  "red",
                  "orange",
                  "blue",
                  "yellow",
                  "grey"
                ]
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "condition": {
                      "type": "string"
                    },
                    "node_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "iap_stg_chapter": {
      "type": "string",
      "description": "IAP Standard Treatment Guidelines 2022 chapter reference"
    },
    "iap_stg_number": {
      "type": "string",
      "description": "IAP STG chapter number"
    },
    "screening_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool_name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "scoring": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          },
          "app_calculator_id": {
            "type": "string"
          }
        }
      },
      "description": "Linked screening tools and scoring systems"
    },
    "evidence_level": {
      "type": "string"
    },
    "linked_module": {
      "type": "string"
    },
    "related_drugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pdf_url": {
      "type": "string"
    },
    "external_link": {
      "type": "string"
    },
    "doi_url": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "content": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "key_points": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Review",
        "Published",
        "Archived"
      ],
      "default": "Draft"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "EXPERT_REVIEWED",
        "PENDING_REVIEW",
        "AI_GENERATED",
        "AI_SUGGESTION",
        "DRAFT"
      ],
      "default": "DRAFT"
    },
    "reviewed_by": {
      "type": "string"
    },
    "primary_guideline_org": {
      "type": "string"
    },
    "supporting_guidelines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "category",
    "source",
    "scope_and_population"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.reviewed_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.reviewed_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}