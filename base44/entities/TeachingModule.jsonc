{
  "name": "TeachingModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Module title"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dialysis",
        "AKI",
        "CKD",
        "Glomerular Diseases",
        "Electrolytes",
        "Hypertension",
        "Transplant",
        "General Nephrology",
        "Procedures",
        "Pathology",
        "Metabolic & Genetic",
        "Tubular Disorders",
        "Congenital & CAKUT",
        "Oncology"
      ],
      "description": "Module category"
    },
    "content": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "string"
        },
        "learning_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "key_points": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "diagrams": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ],
      "description": "Difficulty level"
    },
    "estimated_duration": {
      "type": "string"
    },
    "clinical_pearls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_pitfalls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quizzes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "number"
          },
          "explanation": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ]
          }
        }
      }
    },
    "practice_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_description": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PDF",
              "Video",
              "Article",
              "Guideline"
            ]
          }
        }
      }
    },
    "uploaded_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_guideline_id": {
      "type": "string",
      "description": "Optional pointer to the canonical Guideline record"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": []
}