{
  "name": "TeachingModule",
  "type": "object",
  "properties": {
    "category": {
      "description": "Module category",
      "enum": [
        "Dialysis",
        "AKI",
        "CKD",
        "Glomerular Diseases",
        "Electrolytes",
        "Hypertension",
        "Transplant",
        "General Nephrology",
        "Procedures",
        "Pathology",
        "Metabolic & Genetic",
        "Tubular Disorders",
        "Congenital & CAKUT"
      ],
      "type": "string"
    },
    "clinical_pearls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "common_pitfalls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "content": {
      "properties": {
        "learning_objectives": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "overview": {
          "type": "string"
        },
        "topics": {
          "items": {
            "properties": {
              "content": {
                "type": "string"
              },
              "diagrams": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "heading": {
                "type": "string"
              },
              "key_points": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "created_by": {
      "type": "string"
    },
    "difficulty_level": {
      "description": "Difficulty level",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ],
      "type": "string"
    },
    "estimated_duration": {
      "type": "string"
    },
    "is_default": {
      "default": false,
      "type": "boolean"
    },
    "linked_guideline_id": {
      "description": "Optional pointer to the canonical Guideline record holding the full reference pathway for this topic, so the module links to it instead of duplicating reference prose.",
      "type": "string"
    },
    "practice_cases": {
      "items": {
        "properties": {
          "answers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "case_description": {
            "type": "string"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "quizzes": {
      "items": {
        "properties": {
          "correct_answer": {
            "type": "number"
          },
          "difficulty": {
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ],
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "question": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "resources": {
      "items": {
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "PDF",
              "Video",
              "Article",
              "Guideline"
            ],
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "title": {
      "description": "Module title",
      "type": "string"
    },
    "uploaded_files": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": []
}