{
  "name": "PatientEducationAssignment",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Reference to Patient"
    },
    "patient_name": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string",
      "description": "Clinician email"
    },
    "material_title": {
      "type": "string"
    },
    "material_type": {
      "type": "string",
      "enum": [
        "Article",
        "Video",
        "PDF",
        "Guideline",
        "Infographic",
        "Podcast"
      ],
      "default": "Article"
    },
    "material_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium"
    },
    "completion_status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Completed"
      ],
      "default": "Not Started"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time"
    },
    "engagement_time_minutes": {
      "type": "number",
      "default": 0
    },
    "patient_notes": {
      "type": "string",
      "description": "Patient's notes/questions on this material"
    },
    "clinician_notes": {
      "type": "string",
      "description": "Instructions from clinician"
    },
    "quiz_score": {
      "type": "number"
    },
    "last_accessed": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "patient_id",
    "material_title",
    "assigned_by"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}