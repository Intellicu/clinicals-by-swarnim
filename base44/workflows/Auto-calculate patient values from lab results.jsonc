{
  "name": "Auto-calculate patient values from lab results",
  "description": "When a LabResult is created or updated for a patient, automatically calculates eGFR (Schwartz), AKI stage (KDIGO), electrolyte alerts, UPCR, and updates the linked Patient record.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "LabResult"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_calculate_patient_values_from_lab_results",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onLabResultCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onLabResultCreated"
  }
}